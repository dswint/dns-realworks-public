# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth — staff live in Postgres, not Supabase Auth.
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Production: set BETTER_AUTH_URL and NEXT_PUBLIC_SITE_URL to the public site origin.
# Session pooler (port 5432). Direct db.*.supabase.co is IPv6-only and fails on Vercel.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_POOLER_REGION=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEV_FALLBACK_COMPANY_SLUG=dns-realworks

# Optional: send guest magic links. In local, the link is logged if unset.
RESEND_API_KEY=
MAIL_FROM="DNS Realworks <hello@example.com>"

# Stripe (platform account for tenant zero). Connect uses companies.stripe_account_id later.
# Use sk_test_… / pk_test_… locally/preview. Live keys only on production when ready.
# Webhook: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed. Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Hospitable POST /reservations (no API sandbox). Default: off except Vercel production.
# Set false on production to pause write-back; set true on preview to test one controlled write.
# HOSPITABLE_RESERVATION_WRITE=false

# Protect Vercel cron routes
CRON_SECRET=

# House guide drafts. On Vercel, the AI Gateway uses OIDC.
# Locally, create a key in the Vercel AI Gateway dashboard.
# Drafts run only when staff click Draft from new messages.
AI_GATEWAY_API_KEY=
